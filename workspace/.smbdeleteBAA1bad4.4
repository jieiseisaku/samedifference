<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>same difference — control</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body { width: 100%; min-height: 100%; background: #111; color: #eee;
    font-family: -apple-system, "Helvetica Neue", sans-serif; }
  #wrap { max-width: 720px; margin: 0 auto; padding: 24px 20px 60px; }
  h1 { font-size: 16px; font-weight: 600; margin-bottom: 4px; }
  .desc { color: #888; font-size: 12px; line-height: 1.7; margin-bottom: 20px; }
  .desc code { background: #222; padding: 1px 5px; border-radius: 3px; }

  .row { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin-bottom: 16px; }
  button {
    background: #2a2a2a; color: #eee; border: 1px solid #444;
    border-radius: 6px; padding: 9px 16px; font-size: 14px; cursor: pointer;
  }
  button:hover { background: #3a3a3a; }
  button.active { background: #4a7dff; border-color: #4a7dff; color: #fff; }
  label { display: flex; align-items: center; gap: 6px; font-size: 14px; }
  input[type=number] {
    width: 60px; background: #1a1a1a; color: #eee; border: 1px solid #444;
    border-radius: 4px; padding: 6px 8px; font-size: 14px;
  }
  .sep { width: 1px; height: 24px; background: #333; }

  #openRow button { background: #1f3a1f; border-color: #2f5f2f; }
  #openRow button:hover { background: #2a4a2a; }

  #status { color: #9ab; font-size: 13px; margin: 8px 0 20px; }

  /* モニタ間隔を実機に合わせる：横幅1に対して隙間0.88
     幅w×2 + 隙間0.88w = 2.88w = 100% → w = 100/2.88% */
  .previews { display: flex; justify-content: center; }
  .pv { width: calc(100% / 2.88); flex: none; }
  .previews .pv:first-child { margin-right: calc((100% / 2.88) * 0.88); }
  .pv h2 { font-size: 11px; color: #888; margin-bottom: 4px; font-weight: 500; }
  .pv .frame { position: relative; width: 100%; aspect-ratio: 16/9;
    background: #000; border: 1px solid #333; border-radius: 4px; overflow: hidden; }
  .pv video { position:absolute; top:0; left:0; width:100%; height:100%; object-fit: contain; }
</style>
</head>
<body>
<div id="wrap">
  <h1>same difference — control</h1>
  <div class="desc">
    このページで抽選と再生を操作します。<code>display_L.html</code> をモニター1、<code>display_R.html</code> をモニター2で開き、各画面をクリックすると全画面になります。<br>
    動画 <code>L_01.mp4…</code> / <code>R_01.mp4…</code> は3ファイルとも同じフォルダに置いてください。ペア数は下の <code>PAIR_COUNT</code>（ファイル冒頭）で変更します。<br>
    先読み方式なので、各モニターは常に2本のみ保持します。モード切り替えは次の切り替えから反映されます。
  </div>

  <div class="row" id="openRow">
    <button id="openBoth">2画面を同時に開く</button>
    <button id="openL">モニター1（L）を開く</button>
    <button id="openR">モニター2（R）を開く</button>
  </div>

  <div class="row">
    <button id="startBtn">開始</button>
    <div class="sep"></div>
    <button id="modeRandom" class="active">ランダム</button>
    <button id="modePair">ペア</button>
    <div class="sep"></div>
    <label>間隔 <input type="number" id="interval" value="30" min="1" step="1"> 秒</label>
    <div class="sep"></div>
    <button id="pvToggle" class="active">プレビューON</button>
  </div>

  <div class="row">
    <label>ペア数 <input type="number" id="pairCount" value="7" min="1" step="1"></label>
    <button id="autoDetect">動画から自動取得</button>
    <span id="detectMsg" style="color:#888;font-size:12px;"></span>
  </div>

  <div id="status">停止中</div>

  <div class="previews">
    <div class="pv"><h2>L プレビュー</h2><div class="frame"><video id="pvL" muted playsinline loop></video></div></div>
    <div class="pv"><h2>R プレビュー</h2><div class="frame"><video id="pvR" muted playsinline loop></video></div></div>
  </div>
</div>

<script>
/* =========================================================
   ペア数は画面の「ペア数」入力欄で変更できます。
   「動画から自動取得」を押すと L_01.mp4 から順に存在を調べて自動設定します。
   ========================================================= */
let PAIR_COUNT = 7;          // 入力欄から更新される
const PAD = 2;

const ch = new BroadcastChannel('same_difference');

const startBtn = document.getElementById('startBtn');
const modeRandomBtn = document.getElementById('modeRandom');
const modePairBtn = document.getElementById('modePair');
const intervalInput = document.getElementById('interval');
const statusEl = document.getElementById('status');
const pvL = document.getElementById('pvL');
const pvR = document.getElementById('pvR');
const pairCountInput = document.getElementById('pairCount');
const autoDetectBtn = document.getElementById('autoDetect');
const detectMsg = document.getElementById('detectMsg');

let running = false;
let mode = 'random';
let timer = null;
let lastSwitch = 0;
let previewOn = true;
let curL = 0, curR = 0, nextL = 0, nextR = 0;

function num(n){ return String(n).padStart(PAD, '0'); }
function pick(prev){
  if (PAIR_COUNT <= 1) return 1;
  let n; do { n = Math.floor(Math.random()*PAIR_COUNT)+1; } while (n === prev);
  return n;
}

// モードに応じて L/R の次番号を決める
function drawNext(prevL, prevR){
  if (mode === 'pair'){ const v = pick(prevL); return [v, v]; }
  return [pick(prevL), pick(prevR)];
}

function preview(){
  statusEl.textContent = `再生中　L_${num(curL)} / R_${num(curR)}`;
  if (!previewOn){ pvL.removeAttribute('src'); pvR.removeAttribute('src'); pvL.load(); pvR.load(); return; }
  pvL.src = `L_${num(curL)}.mp4`; pvL.play().catch(()=>{});
  pvR.src = `R_${num(curR)}.mp4`; pvR.play().catch(()=>{});
}

function start(){
  running = true; startBtn.textContent = '停止';
  [curL, curR]   = drawNext(0, 0);
  [nextL, nextR] = drawNext(curL, curR);
  ch.postMessage({ type:'init', Lcur:curL, Rcur:curR, Lnext:nextL, Rnext:nextR });
  preview();
  schedule();
}

function stop(){
  running = false; startBtn.textContent = '開始';
  clearInterval(timer);
  ch.postMessage({ type:'stop' });
  statusEl.textContent = '停止中';
}

// 次サイクル：cur を次へ進め、新しい next を先読みさせる
function advance(){
  curL = nextL; curR = nextR;
  [nextL, nextR] = drawNext(curL, curR);
  ch.postMessage({ type:'advance', Lcur:curL, Rcur:curR, Lnext:nextL, Rnext:nextR });
  preview();
}

function schedule(){
  clearInterval(timer);
  lastSwitch = Date.now();
  // 実時間で経過を判定。0.5秒ごとに現在状態を sync 送信し続けるので、
  // 表示ページが一度指示を取りこぼしても次の sync で必ず追従する。
  timer = setInterval(()=>{
    if(!running) return;
    const sec = Math.max(1, parseFloat(intervalInput.value) || 30);
    if (Date.now() - lastSwitch >= sec*1000){
      lastSwitch = Date.now();
      advance();
    } else {
      // 表示中の状態を再送信（ハートビート）
      ch.postMessage({ type:'sync', Lcur:curL, Rcur:curR, Lnext:nextL, Rnext:nextR });
    }
  }, 500);
}

startBtn.addEventListener('click', ()=> running ? stop() : start());
modeRandomBtn.addEventListener('click', ()=>{
  mode='random'; modeRandomBtn.classList.add('active'); modePairBtn.classList.remove('active');
});
modePairBtn.addEventListener('click', ()=>{
  mode='pair'; modePairBtn.classList.add('active'); modeRandomBtn.classList.remove('active');
});
intervalInput.addEventListener('change', ()=>{ if(running){ lastSwitch = Date.now(); } });

// ペア数を入力欄と同期
pairCountInput.addEventListener('change', ()=>{
  const v = Math.max(1, parseInt(pairCountInput.value) || 1);
  PAIR_COUNT = v; pairCountInput.value = v;
});

// 動画から自動取得：L_01.mp4 から順に存在を調べ、途切れたところまでをペア数にする
autoDetectBtn.addEventListener('click', async ()=>{
  detectMsg.textContent = '確認中…';
  let count = 0;
  for (let i = 1; i <= 999; i++){
    const okL = await fileExists(`L_${num(i)}.mp4`);
    const okR = await fileExists(`R_${num(i)}.mp4`);
    if (okL && okR){ count = i; } else { break; }
  }
  if (count > 0){
    PAIR_COUNT = count;
    pairCountInput.value = count;
    detectMsg.textContent = `${count} ペアを検出`;
  } else {
    detectMsg.textContent = 'L_01.mp4 / R_01.mp4 が見つかりません';
  }
});

// video要素で読み込めるかを確認（file:// でも動く）
function fileExists(url){
  return new Promise((resolve)=>{
    const v = document.createElement('video');
    let settled = false;
    const done = (ok)=>{ if(settled) return; settled = true; v.removeAttribute('src'); v.load(); resolve(ok); };
    v.muted = true;
    v.addEventListener('loadeddata', ()=> done(true),  { once: true });
    v.addEventListener('error',      ()=> done(false), { once: true });
    setTimeout(()=> done(false), 4000);   // 応答なしは無しとみなす
    v.src = url;
    v.load();
  });
}

document.getElementById('pvToggle').addEventListener('click', (e)=>{
  previewOn = !previewOn;
  e.target.classList.toggle('active', previewOn);
  e.target.textContent = previewOn ? 'プレビューON' : 'プレビューOFF';
  if (running) preview();
  else if (!previewOn){ pvL.removeAttribute('src'); pvR.removeAttribute('src'); pvL.load(); pvR.load(); }
});

document.getElementById('openBoth').addEventListener('click', ()=>{
  window.open('display_L.html','sd_L');
  setTimeout(()=>{ window.open('display_R.html','sd_R'); }, 300);
});
document.getElementById('openL').addEventListener('click', ()=> window.open('display_L.html','sd_L'));
document.getElementById('openR').addEventListener('click', ()=> window.open('display_R.html','sd_R'));

document.addEventListener('keydown', (e)=>{
  if(e.key === ' '){ e.preventDefault(); running ? stop() : start(); }
  if(e.key.toLowerCase() === 'n' && running){ lastSwitch = Date.now(); advance(); }
});
</script>
</body>
</html>
