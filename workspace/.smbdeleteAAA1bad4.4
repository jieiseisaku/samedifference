<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>same difference — L</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body { width: 100%; height: 100%; background: #000; overflow: hidden; cursor: none; }
  .panel { position: relative; width: 100vw; height: 100vh; background: #000; overflow: hidden; }
  .panel video {
    position: absolute; top: 0; left: 0;
    width: 100%; height: 100%;
    object-fit: contain; display: block;
    opacity: 0;
  }
  .panel video.show { opacity: 1; }
  #wait {
    position: fixed; left: 50%; top: 50%; transform: translate(-50%,-50%);
    color: #444; font-family: sans-serif; font-size: 14px;
  }
</style>
</head>
<body>
<div class="panel">
  <video class="layer" muted playsinline></video>
  <video class="layer" muted playsinline></video>
</div>
<div id="wait">コントロール画面の待機中…</div>

<script>
/* L表示ページ。
   control から毎回 {cur, next} を受け取る。
   - cur を表示（先読み済みなら即／未完了なら読めしだい、保険で強制）
   - もう片方のレイヤーに next を先読み
   状態は「今表示している番号」だけ。詰まっても次の指示で必ず上書きされる。 */
const SIDE = 'L';
const PAD = 2;

const layers = document.querySelectorAll('.layer');
const waitEl = document.getElementById('wait');

let curIdx = 0;        // 現在表示中レイヤー
let shownNum = -1;     // 現在表示中の番号
let targetNum = -1;    // 現在切り替え中の目標番号（読み込み中を含む）
let gen = 0;           // 最新指示のみ有効にする世代番号

function num(n){ return String(n).padStart(PAD, '0'); }
function src(i){ return `${SIDE}_${num(i)}.mp4`; }

function setLayer(layer, i){
  if (layer.dataset.num === String(i) && layer.src){ return; } // 既に同じ動画なら読み直さない
  layer.loop = true; layer.muted = true;
  layer.dataset.num = String(i);
  layer.src = src(i);
  layer.load();
}

// 指定番号を表示。もう片方に next を先読み。
function render(cur, next){
  waitEl.style.display = 'none';

  // 既に表示中、または今その番号へ切り替え中なら、先読みだけ更新して終わり
  if (cur === shownNum || cur === targetNum){
    const otherIdx = curIdx === 0 ? 1 : 0;
    setLayer(layers[otherIdx], next);
    return;
  }

  const myGen = ++gen;
  targetNum = cur;

  const showIdx = curIdx === 0 ? 1 : 0;   // 空いている側に cur を用意して見せる
  const showV = layers[showIdx];
  const oldV  = layers[curIdx];

  setLayer(showV, cur);

  const reveal = ()=>{
    if (myGen !== gen) return;             // 古い指示は破棄
    showV.play().catch(()=>{});
    showV.classList.add('show');
    requestAnimationFrame(()=> requestAnimationFrame(()=>{
      if (myGen !== gen) return;
      oldV.classList.remove('show');
      try{ oldV.pause(); }catch(e){}
      curIdx = showIdx;
      shownNum = cur;
      setLayer(oldV, next);                // 空いたレイヤーへ次を先読み
    }));
  };

  if (showV.readyState >= 2){ reveal(); }
  else {
    let done = false;
    const once = ()=>{ if(done) return; done = true; reveal(); };
    showV.addEventListener('loadeddata', once, { once: true });
    showV.addEventListener('error', once, { once: true });
    setTimeout(once, 2000);                // 読み込みが詰まっても2秒で進める
  }
}

const ch = new BroadcastChannel('same_difference');
ch.onmessage = (e)=>{
  const m = e.data;
  if (m.type === 'init' || m.type === 'advance'){
    render(m[SIDE+'cur'], m[SIDE+'next']);
  }
  if (m.type === 'sync'){
    // 表示中と番号が違うときだけ追従（取りこぼし復帰用）。同じなら何もしない。
    if (m[SIDE+'cur'] !== shownNum){ render(m[SIDE+'cur'], m[SIDE+'next']); }
  }
};

document.addEventListener('click', ()=>{
  if(!document.fullscreenElement) document.documentElement.requestFullscreen();
});
document.addEventListener('keydown', (e)=>{
  if(e.key.toLowerCase() === 'f'){
    if(!document.fullscreenElement) document.documentElement.requestFullscreen();
    else document.exitFullscreen();
  }
});
</script>
</body>
</html>
